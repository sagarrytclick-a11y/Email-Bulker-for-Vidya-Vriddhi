# SMTP delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
MAIL_FROM_NAME="Likoy Vidya Vriddhi Email Bulker"
MAIL_FROM_EMAIL=you@example.com
MAIL_REPLY_TO=you@example.com

# Delivery throttling (server-enforced — tuned for a FREE Gmail account)
# Free Gmail: ~500 recipients/day limit. Daily cap is set to 300 to stay clearly under it.
# Speed stays ~100/hour (batch 10 + 5 min cooldown) so 300 sends spread over ~3 hours.
DELAY_MS=6000
BATCH_SIZE=10
BATCH_COOLDOWN_MS=300000
SESSION_CAP=300
# Hard daily cap across ALL campaigns (stops sending once reached; resumes next day)
DAILY_SEND_CAP=300

# Campaign history database (MongoDB)
# Create a free M0 cluster at https://cloud.mongodb.com → Connect → Drivers → copy the URI.
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name inside the cluster. Defaults to bulk_email.
MONGODB_DB=bulk_email

# Dashboard authentication (required)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-password
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
